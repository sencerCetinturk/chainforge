{
  "name": "chainforge",
  "displayName": "ChainForge — Multi-Model AI Chat & Agents",
  "description": "AI coding assistant for VS Code. Chat, auto-edit files, and run a self-healing inspect/fix loop with 400+ models (GPT, Claude, Gemini, DeepSeek) via OpenRouter. Smart routing, automatic fallback, free-tier included.",
  "version": "1.4.3",
  "publisher": "sencerCetinturk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "copilot",
    "chatgpt",
    "openrouter",
    "claude",
    "llm",
    "gpt",
    "gemini",
    "deepseek",
    "ai agent",
    "coding assistant",
    "multi-model",
    "ai chain",
    "ai orchestration",
    "fallback",
    "minimax",
    "glm",
    "automation"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/sencerCetinturk/chainforge",
  "bugs": {
    "url": "https://github.com/sencerCetinturk/chainforge/issues",
    "email": "sencercetinturk19@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sencerCetinturk/chainforge.git"
  },
  "activationEvents": [
    "*",
    "onView:chainforgeView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chainforge",
          "title": "ChainForge",
          "icon": "icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "chainforge": [
        {
          "type": "webview",
          "id": "chainforgeView",
          "name": "ChainForge"
        }
      ]
    },
    "commands": [
      {
        "command": "chainforge.openPanel",
        "title": "ChainForge: Open Panel",
        "icon": "icon-activitybar.svg"
      },
      {
        "command": "chainforge.openFullView",
        "title": "ChainForge: Open in Full View (Editor Tab)",
        "icon": "icon-activitybar.svg"
      },
      {
        "command": "chainforge.agentTaskFromSelection",
        "title": "ChainForge: Run Task on Selection"
      },
      {
        "command": "chainforge.runTask",
        "title": "ChainForge: Run Task"
      },
      {
        "command": "chainforge.agentTask",
        "title": "ChainForge: Agent Task (Auto Edit Files)"
      },
      {
        "command": "chainforge.inspect",
        "title": "ChainForge: Inspect Files (Denetmen)"
      },
      {
        "command": "chainforge.inspectReset",
        "title": "ChainForge: Reset Inspector Checkpoint"
      },
      {
        "command": "chainforge.configure",
        "title": "ChainForge: Configure"
      }
    ],
    "walkthroughs": [
      {
        "id": "chainforgeGettingStarted",
        "title": "ChainForge'a Başlarken",
        "description": "Ücretsiz modellerle sohbet et, agent ile dosya düzenlet, kodunu otomatik denetlet.",
        "icon": "icon.svg",
        "steps": [
          {
            "id": "connectKey",
            "title": "API Key Bağla (opsiyonel)",
            "description": "Ücretsiz modellerle key olmadan da başlayabilirsin.",
            "media": { "markdown": "walkthrough/01-connect-key.md" }
          },
          {
            "id": "chat",
            "title": "Sohbet Et",
            "description": "Projeni otomatik okuyan bir AI asistanla konuş.",
            "media": { "markdown": "walkthrough/02-chat.md" },
            "completionEvents": ["onCommand:chainforge.openPanel"]
          },
          {
            "id": "agentTask",
            "title": "Agent İle Dosya Düzenlet",
            "description": "Görevini yaz, diff'i onayla, ChainForge uygulasın.",
            "media": { "markdown": "walkthrough/03-agent-task.md" },
            "completionEvents": ["onCommand:chainforge.agentTask"]
          },
          {
            "id": "inspector",
            "title": "Denetmen İle Tara",
            "description": "Kodundaki hataları bul, Postacı otomatik düzeltsin.",
            "media": { "markdown": "walkthrough/04-inspector.md" },
            "completionEvents": ["onCommand:chainforge.inspect"]
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "chainforge.openPanel",
          "group": "navigation",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "chainforge.openFullView",
          "when": "view == chainforgeView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "chainforge.agentTaskFromSelection",
          "group": "chainforge",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "ChainForge",
      "properties": {
        "chainforge.openRouterKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API Key — get yours free at openrouter.ai"
        },
        "chainforge.customInstructions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "PRO: Her sohbet ve agent görevine otomatik eklenecek kişisel talimatlarınız (örn. kodlama tarzı, tercih ettiğiniz kütüphaneler). Panelde Ayarlar > Pro License > \"Özel Talimatlarım\" üzerinden düzenlenir. Sadece Pro lisansla aktif olur."
        },
        "chainforge.monthlyBudgetUsd": {
          "type": "number",
          "default": 0,
          "description": "Aylık tahmini harcama tavanı (USD). 0 = sınırsız. Bu değere ulaşıldığında/aşıldığında uyarı gösterilir."
        },
        "chainforge.autoCheckpoint": {
          "type": "boolean",
          "default": false,
          "description": "Ajan dosyaları değiştirmeden önce, workspace'te commit edilmemiş değişiklikler varsa bunları otomatik bir git checkpoint commit'i olarak kaydet. Kapalıyken sadece uyarı gösterilir."
        },
        "chainforge.telemetryEndpoint": {
          "type": "string",
          "default": "",
          "description": "Anonim telemetri için genel HTTPS endpoint (webhook vb.). Firebase kullanıyorsanız aşağıdaki Firebase alanlarını doldurun."
        },
        "chainforge.telemetryFirebaseProjectId": {
          "type": "string",
          "default": "",
          "description": "Firebase proje ID'si (telemetri Firestore'a yazılır). Geliştirici tarafından ayarlanır."
        },
        "chainforge.telemetryFirebaseApiKey": {
          "type": "string",
          "default": "",
          "description": "Firebase Web API anahtarı. Geliştirici tarafından ayarlanır."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p . && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.45",
    "typescript": "^5.0.0"
  }
}
