{
  "version": "1.0",
  "openRouterKey": "",
  "agents": {
    "worker": {
      "name": "AI Worker",
      "model": "minimax/minimax-m3",
      "role": "coding",
      "fallback": "fallback",
      "maxRetries": 3,
      "systemPrompt": "You are an expert software developer. Write clean, efficient, well-documented code."
    },
    "fallback": {
      "name": "Fallback",
      "model": "google/gemini-flash-1-5",
      "role": "fallback",
      "maxRetries": 2
    }
  },
  "tasks": {
    "coding": {
      "primary": "worker",
      "description": "Code writing, editing, refactor"
    },
    "review": {
      "primary": "supervisor",
      "description": "Code review, architecture"
    },
    "general": {
      "primary": "worker",
      "description": "General questions"
    }
  }
}